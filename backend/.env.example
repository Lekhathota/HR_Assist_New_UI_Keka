# Copy to .env and adjust values.

# MongoDB Atlas connection (required)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URL, generated by Vercel's MongoDB integration, is also supported.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recruitment_assist

# Flask session signing (use a long random string in production)
SECRET_KEY=replace-with-a-long-random-secret

# Optional: OpenAI / LLM keys used by app/llm_extraction.py (see existing project docs)
OPENAI_API_KEY=

# SMTP email configuration for interview scheduling
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourcompanyhr@gmail.com
SMTP_PASS=your_gmail_app_password
DEFAULT_FROM_EMAIL=yourcompanyhr@gmail.com

# Dev server (must match frontend/package.json "proxy" port)
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
PORT=5001

# SPA dev URL — must match where `npm start` runs (see frontend/.env PORT).
# FRONTEND_URL=http://localhost:3001

# SPA on another origin (comma-separated). Default includes CRA dev server.
# CORS_ORIGINS=http://localhost:3000

# Public URL serving the React app; candidate links (/assessment/<token>, /interview/<token>) use it.
# CANDIDATE_TEST_BASE_URL=https://your-app.example.com

# Automated interview reschedule & no-show recovery (see docs/interview_recovery.md)
# INTERVIEW_RECOVERY_ENABLED=true
# INTERVIEW_TIMEZONE=Asia/Kolkata                  # zone interview times are entered in (default UTC)
# INTERVIEW_NO_SHOW_DETECTION=confirmed            # confirmed = recruiter clicks "No-show"; auto = no attendance after grace
# INTERVIEW_NO_SHOW_GRACE_MINUTES=15
# INTERVIEW_RECOVERY_MAX_ATTEMPTS=3                # candidate-facing rounds before escalating to the recruiter
# INTERVIEW_RECOVERY_RESPONSE_TIMEOUT_MINUTES=1440
# INTERVIEW_RECOVERY_RETRY_DELAY_MINUTES=60
# INTERVIEW_RECOVERY_MAX_DELIVERY_FAILURES=5
# INTERVIEW_RECOVERY_SLOT_SEARCH_DAYS=10
# INTERVIEW_RECOVERY_SLOT_COUNT=3
# INTERVIEW_RECOVERY_MIN_NOTICE_HOURS=12
# INTERVIEW_RECOVERY_WORKDAY_START_HOUR=9
# INTERVIEW_RECOVERY_WORKDAY_END_HOUR=18
# INTERVIEW_RECOVERY_WORKDAYS=0,1,2,3,4            # 0 = Monday
# INTERVIEW_CALENDAR_PROVIDER=internal
# Secret for the scheduler endpoint /api/interview-recovery/run (Vercel Cron sends CRON_SECRET automatically).
# INTERVIEW_RECOVERY_CRON_SECRET=
